<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MDM" parent="Theme.Material3.Light.NoActionBar">
        <!-- 主色 / 语义色：全部锁定 iOS 色板 -->
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/mdm_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/mdm_on_primary_container</item>
        <item name="colorSecondary">@color/ios_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/mdm_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/mdm_on_secondary_container</item>

        <item name="colorSurface">@color/ios_card</item>
        <item name="colorOnSurface">@color/ios_label</item>
        <item name="colorSurfaceVariant">@color/ios_fill</item>
        <item name="colorOnSurfaceVariant">@color/ios_label_2</item>
        <item name="colorSurfaceContainerLowest">@color/ios_card</item>
        <item name="colorSurfaceContainerLow">@color/ios_card</item>
        <item name="colorSurfaceContainer">@color/ios_card</item>
        <item name="colorSurfaceContainerHigh">@color/ios_card</item>
        <item name="colorSurfaceContainerHighest">@color/ios_fill</item>
        <item name="colorOutline">@color/ios_label_3</item>
        <item name="colorOutlineVariant">@color/ios_separator</item>
        <item name="colorError">@color/ios_red</item>

        <item name="android:windowBackground">@color/ios_bg</item>
        <item name="android:colorBackground">@color/ios_bg</item>

        <!-- iOS 风：浅色状态栏背景 + 深色图标 -->
        <item name="android:statusBarColor">@color/ios_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/ios_bg</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>

        <!-- 组件默认样式 -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MDM.BottomSheetDialog</item>
    </style>


    <!-- 二级页面（关于 / 崩溃日志）：原页淡出，新页自右向左淡入全屏 -->
    <style name="Theme.MDM.Screen" parent="Theme.MDM">
        <item name="android:windowAnimationStyle">@style/Animation.MDM.Screen</item>
    </style>

    <style name="Animation.MDM.Screen" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_pop_exit</item>
    </style>

    <!-- 浏览器唤起时的悬浮确认窗：透明全屏载体，只显示底部面板 -->
    <style name="Theme.MDM.Prompt" parent="Theme.MDM">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.MDM.Prompt</item>
    </style>

    <style name="Animation.MDM.Prompt" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- ========== 底部面板（iOS 卡片风格） ========== -->
    <!-- 版本说明面板：全屏透明窗口 + 自己贴底的面板，遮罩盖满整屏，面板底边不留缝 -->
    <style name="Theme.MDM.Sheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 遮罩由面板载体自己画（只盖内容区），不要 WindowManager 把状态栏一起压暗 -->
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ThemeOverlay.MDM.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MDM.BottomSheet</item>
        <item name="colorSurfaceContainerLow">@color/ios_card</item>
        <item name="colorSurface">@color/ios_card</item>
        <item name="colorOnSurface">@color/ios_label</item>
        <item name="colorPrimary">@color/ios_blue</item>
    </style>

    <style name="Widget.MDM.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/ios_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MDM.Sheet</item>
    </style>

    <style name="ShapeAppearance.MDM.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ========== 文字样式 ========== -->
    <style name="TextAppearance.MDM.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.MDM.CollapsedTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
    </style>

    <style name="TextAppearance.MDM.SectionHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ios_label_2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- ========== 按钮 ========== -->
    <style name="Widget.MDM.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ios_blue</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MDM.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/ios_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 侧边栏选中项圆角 -->
    <style name="ShapeAppearance.MDM.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.MDM.NavItem" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.MDM.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>
</resources>

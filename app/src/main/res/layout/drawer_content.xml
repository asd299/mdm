<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- 顶部：应用信息 + 统计 -->
        <include layout="@layout/nav_header" />

        <!-- ========== 任务状态 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hdrTasks"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="18dp">

                <TextView
                    style="@style/TextAppearance.MDM.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nav_group_tasks" />

                <ImageView
                    android:id="@+id/chevTasks"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/nav_group_tasks"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/ios_label_3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- ========== 文件类型 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="20dp"
                android:background="@color/ios_separator" />

            <LinearLayout
                android:id="@+id/hdrTypes"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="18dp">

                <TextView
                    style="@style/TextAppearance.MDM.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nav_group_category" />

                <ImageView
                    android:id="@+id/chevTypes"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/nav_group_category"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/ios_label_3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- ========== 下载设置（原设置页内容） ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="20dp"
                android:background="@color/ios_separator" />

            <LinearLayout
                android:id="@+id/hdrSettings"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="18dp">

                <TextView
                    style="@style/TextAppearance.MDM.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nav_group_settings" />

                <ImageView
                    android:id="@+id/chevSettings"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/nav_group_settings"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/ios_label_3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowWifi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wifi_only"
                        android:textColor="@color/ios_label"
                        android:textSize="15sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swWifi"
                        style="@style/Widget.MDM.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowRetry"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/auto_retry"
                        android:textColor="@color/ios_label"
                        android:textSize="15sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swRetry"
                        style="@style/Widget.MDM.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSeg"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/seg_count"
                        android:textColor="@color/ios_label"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvSeg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ios_label_2"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ios_label_3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/save_path_label"
                            android:textColor="@color/ios_label"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvSavePath"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/ios_label_2"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ios_label_3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ========== 更多 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="20dp"
                android:background="@color/ios_separator" />

            <LinearLayout
                android:id="@+id/hdrMore"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="18dp">

                <TextView
                    style="@style/TextAppearance.MDM.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nav_group_more" />

                <ImageView
                    android:id="@+id/chevMore"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/nav_group_more"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/ios_label_3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bodyMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="2dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

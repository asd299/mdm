<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部操作行的胶囊按钮：展开排序时（selected）蓝框高亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#EAF3FF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/ios_blue" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_fill" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/ios_separator" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_card" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/ios_separator" />
        </shape>
    </item>
</selector>
